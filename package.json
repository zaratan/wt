{
  "name": "wt",
  "version": "0.1.0",
  "description": "Git worktree manager integrated with herdr",
  "type": "module",
  "private": true,
  "author": "Denis <Zaratan> Pasin <zaratan@hey.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaratan/wt.git"
  },
  "scripts": {
    "dev": "bun src/index.tsx",
    "dev:watch": "bun --watch src/index.tsx",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:darwin-arm64": "bun build src/index.tsx --compile --target=bun-darwin-arm64 --outfile=dist/wt-darwin-arm64",
    "build:linux-x64": "bun build src/index.tsx --compile --target=bun-linux-x64 --outfile=dist/wt-linux-x64",
    "build": "pnpm build:darwin-arm64 && pnpm build:linux-x64",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "prepare": "husky"
  },
  "keywords": [
    "cli",
    "git",
    "worktree",
    "herdr",
    "ink",
    "bun"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "ink": "6.6.0",
    "ink-text-input": "6.0.0",
    "react": "19.2.3",
    "smol-toml": "1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "25.0.7",
    "@types/react": "19.2.8",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "17.0.0",
    "husky": "9.1.7",
    "ink-testing-library": "4.0.0",
    "lint-staged": "16.2.7",
    "prettier": "3.7.4",
    "react-devtools-core": "7.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0",
    "vitest": "4.0.17"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
